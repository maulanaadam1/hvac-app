# ==============================================================
# HVAC BACKEND ENV DRAFT
# ==============================================================

# 1. Aplikasi
PROJECT_NAME="HVAC Management Platform"
API_V1_STR="/api/v1"

# 2. Keamanan CORS (Alamat Frontend yang diizinkan mengakses API ini)
# Gunakan koma untuk lebih dari 1 alamat tanpa spasi.
BACKEND_CORS_ORIGINS="http://localhost:3000,https://hvac-frontend.easypanel.host"

# 3. Kredensial Super Admin Pertama (Dibuat otomatis jika DB kosong)
FIRST_SUPERUSER="admin"
FIRST_SUPERUSER_PASSWORD="SandiSuperKuat123!"

# 4. Database PostgreSQL (Didapat dari service Database di Easypanel)
# Format: postgresql://[user]:[password]@[host]:[port]/[nama_db]
# Kosongkan atau hapus baris ini jika ingin fallback menggunakan SQLite lokal
DATABASE_URL="postgresql://postgres:random_password123@postgres-hvac:5432/hvac_db"
